# Anthropic API key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database URL (defaults to SQLite; change to PostgreSQL for production)
# DATABASE_URL=sqlite+aiosqlite:///./resolveai.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/resolveai

# Models (swap planner to claude-opus-4-6 for better analysis quality)
# PLANNER_MODEL=claude-sonnet-4-6
# EXECUTOR_MODEL=claude-sonnet-4-6

# Debug mode
# DEBUG=false
